{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HubForge",
  "version": "0.8.1",
  "identifier": "org.hubforge.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HubForge",
        "width": 1320,
        "height": 820,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "backgroundColor": "#0E0F13",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}